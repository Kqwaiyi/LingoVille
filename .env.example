# Copy to .env (gitignored) and fill in. Only the gateway (server/) reads this file;
# nothing here is exposed to the browser bundle.
GEMINI_API_KEY=

# 1 = mock mode: canned responses, no network, no key needed.
GEMINI_MOCK=0

# Mock mode only: how long the scripted fake NPC waits before each answer, in ms.
# Unset means 600, about a real NPC's pause. The smoke tests set it short.
GEMINI_MOCK_REPLY_MS=

# Port the gateway listens on. Vite proxies /api here.
GATEWAY_PORT=8787
