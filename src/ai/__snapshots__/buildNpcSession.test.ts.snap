      "name": "not_understood",
      "parameters": {
        "properties": {
          "reason": {
            "enum": [
              "unintelligible",
              "other_language",
              "nothing_heard",
            ],
            "type": "STRING",
          },
        },
        "required": [
          "reason",
        ],
        "type": "OBJECT",
      },
    },
  ],
  "voice": {
    "npcId": "barista",
    "targetLanguage": "ja",
  },
}
`;

