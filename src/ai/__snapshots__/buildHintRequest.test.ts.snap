    "responseSchema": {
      "properties": {
        "hints": {
          "items": {
            "properties": {
              "text": {
                "description": "A full sentence the learner could say next, in the Target Language.",
                "type": "STRING",
              },
              "translation": {
                "description": "The sentence, translated into the Native Language.",
                "type": "STRING",
              },
            },
            "required": [
              "text",
